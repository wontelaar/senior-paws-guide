---
import BaseLayout from './BaseLayout.astro';
import AffiliateDisclosure from '../components/AffiliateDisclosure.astro';
import RelatedPosts from '../components/RelatedPosts.astro';

interface RelatedPost {
	id: string;
	data: {
		title: string;
		description: string;
		heroImage?: string;
	};
}

interface Props {
	title: string;
	description: string;
	heroImage?: string;
	related?: RelatedPost[];
}

const { title, description, heroImage, related = [] } = Astro.props;
---

<BaseLayout title={title} description={description} image={heroImage}>
	<article>
		<header class="post-header">
			<h1>{title}</h1>
		</header>

		{heroImage && (
			<img class="post-hero" src={heroImage} alt="" loading="eager" />
		)}

		<AffiliateDisclosure />

		<div class="post-body">
			<slot />
		</div>

		<RelatedPosts posts={related} />
	</article>
</BaseLayout>

<style>
	.post-header h1 { margin-bottom: 0.25rem; }
	.post-hero {
		display: block;
		width: 100%;
		max-height: 420px;
		object-fit: cover;
		border-radius: 10px;
		margin: 1rem 0;
	}
	.post-body { margin-top: 1.5rem; }
</style>
