---
import siteConfig from '../../site.config.json' with { type: 'json' };

interface Props {
	title: string;
	description: string;
}

const { title, description } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const siteName = siteConfig.siteName;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="canonical" href={canonicalURL} />
		<title>{title} | {siteName}</title>
		<meta name="description" content={description} />

		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />

		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />

		<link rel="sitemap" href="/sitemap-index.xml" />
		<link
			rel="alternate"
			type="application/rss+xml"
			title={siteName}
			href={new URL('rss.xml', Astro.site)}
		/>
	</head>
	<body>
		<header class="site-header">
			<a class="brand" href="/">{siteName}</a>
			<nav>
				<a href="/">Home</a>
				<a href="/about">About</a>
			</nav>
		</header>

		<main>
			<slot />
		</main>

		<footer class="site-footer">
			<nav>
				<a href="/about">About</a>
				<a href="/contact">Contact</a>
				<a href="/privacy-policy">Privacy Policy</a>
				<a href="/affiliate-disclosure">Affiliate Disclosure</a>
			</nav>
			<p>&copy; {new Date().getFullYear()} {siteName}. As an Amazon Associate we earn from qualifying purchases.</p>
		</footer>

		<style is:global>
			:root {
				color-scheme: light dark;
				--fg: #1a1a1a;
				--bg: #ffffff;
				--muted: #666666;
				--accent: #b5651d;
				--border: #e5e5e5;
			}
			@media (prefers-color-scheme: dark) {
				:root {
					--fg: #eaeaea;
					--bg: #14141a;
					--muted: #a0a0a8;
					--border: #2a2a32;
				}
			}
			* { box-sizing: border-box; }
			body {
				margin: 0;
				font-family: system-ui, -apple-system, 'Segoe UI', sans-serif;
				color: var(--fg);
				background: var(--bg);
				line-height: 1.6;
			}
			main {
				max-width: 760px;
				margin: 0 auto;
				padding: 1.5rem 1.25rem 3rem;
			}
			.site-header, .site-footer {
				max-width: 760px;
				margin: 0 auto;
				padding: 1.25rem;
				display: flex;
				justify-content: space-between;
				align-items: center;
				flex-wrap: wrap;
				gap: 0.75rem;
			}
			.site-footer {
				flex-direction: column;
				align-items: flex-start;
				border-top: 1px solid var(--border);
				color: var(--muted);
				font-size: 0.85rem;
			}
			.brand { font-weight: 700; text-decoration: none; color: var(--fg); font-size: 1.1rem; }
			nav a { color: var(--muted); text-decoration: none; margin-right: 1rem; }
			nav a:hover { color: var(--accent); }
			img { max-width: 100%; }
			table { width: 100%; border-collapse: collapse; margin: 1.5rem 0; }
			th, td { border: 1px solid var(--border); padding: 0.5rem 0.75rem; text-align: left; }
			th { background: color-mix(in srgb, var(--accent) 12%, transparent); }

			/* Small product photo shown inline right before a product's first
			   link mention — inside a table cell, a heading, or prose — so
			   images sit next to the text discussing that product instead of
			   being grouped separately. */
			.product-inline-thumb {
				width: 44px;
				height: 44px;
				object-fit: contain;
				vertical-align: middle;
				margin-right: 0.4rem;
				padding: 2px;
				border: 1px solid var(--border);
				border-radius: 6px;
				background: #fff;
			}
		</style>
	</body>
</html>
