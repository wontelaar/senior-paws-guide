---
import siteConfig from '../../site.config.json' with { type: 'json' };

interface Props {
	title: string;
	description: string;
}

const { title, description } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const siteName = siteConfig.siteName;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<link rel="canonical" href={canonicalURL} />
		<title>{title} | {siteName}</title>
		<meta name="description" content={description} />

		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />

		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />

		<link rel="sitemap" href="/sitemap-index.xml" />
		<link
			rel="alternate"
			type="application/rss+xml"
			title={siteName}
			href={new URL('rss.xml', Astro.site)}
		/>
	</head>
	<body>
		<header class="site-header">
			<a class="brand" href="/">
				<img class="brand-mark" src="/dog-mark.png" alt="" width="264" height="300" />
				{siteName}
			</a>
			<nav>
				<a href="/">Home</a>
				<a href="/about">About</a>
				<a href="/search">Search</a>
			</nav>
		</header>

		<main>
			<slot />
		</main>

		<footer class="site-footer">
			<nav>
				<a href="/about">About</a>
				<a href="/contact">Contact</a>
				<a href="/privacy-policy">Privacy Policy</a>
				<a href="/affiliate-disclosure">Affiliate Disclosure</a>
			</nav>
			<p>&copy; {new Date().getFullYear()} {siteName}. As an Amazon Associate we earn from qualifying purchases.</p>
		</footer>

		<style is:global>
			:root {
				color-scheme: light dark;
				--fg: #1a1a1a;
				--bg: #ffffff;
				--muted: #666666;
				--accent: #b5651d;
				--border: #e5e5e5;
			}
			@media (prefers-color-scheme: dark) {
				:root {
					--fg: #eaeaea;
					--bg: #14141a;
					--muted: #a0a0a8;
					--border: #2a2a32;
				}
			}
			* { box-sizing: border-box; }
			body {
				margin: 0;
				font-family: system-ui, -apple-system, 'Segoe UI', sans-serif;
				color: var(--fg);
				background: var(--bg);
				line-height: 1.6;
			}
			main {
				max-width: 760px;
				margin: 0 auto;
				padding: 1.5rem 1.25rem 3rem;
			}
			.site-header, .site-footer {
				max-width: 760px;
				margin: 0 auto;
				padding: 1.25rem;
				display: flex;
				justify-content: space-between;
				align-items: center;
				flex-wrap: wrap;
				gap: 0.75rem;
			}
			.site-footer {
				flex-direction: column;
				align-items: flex-start;
				border-top: 1px solid var(--border);
				color: var(--muted);
				font-size: 0.85rem;
			}
			.brand {
				display: flex;
				align-items: flex-end;
				gap: 0.5rem;
				font-weight: 700;
				text-decoration: none;
				color: var(--fg);
				font-size: 1.1rem;
			}
			.brand-mark { width: auto; height: 2.2em; flex-shrink: 0; }
			nav a { color: var(--muted); text-decoration: none; margin-right: 1rem; }
			nav a:hover { color: var(--accent); }
			img { max-width: 100%; }
			table { width: 100%; border-collapse: collapse; margin: 1.5rem 0; }
			th, td { border: 1px solid var(--border); padding: 0.5rem 0.75rem; text-align: left; }
			th { background: color-mix(in srgb, var(--accent) 12%, transparent); }

			/* "Pick card" — boxed product callout (image + name + blurb + CTA
			   button), one per product, inserted right after its "###
			   Product Name" heading (comparison articles) or right after the
			   paragraph that first mentions it (narrative-guide/qna).
			   Modeled on the review-roundup pattern (Wirecutter-style pick
			   boxes). */
			.product-card {
				display: flex;
				gap: 1.1rem;
				align-items: flex-start;
				border: 1px solid var(--border);
				border-radius: 10px;
				padding: 1rem;
				margin: 1rem 0 1.5rem;
				background: color-mix(in srgb, var(--accent) 4%, transparent);
			}
			.product-card img {
				width: 170px;
				height: 170px;
				object-fit: contain;
				flex-shrink: 0;
				background: #fff;
				border: 1px solid var(--border);
				border-radius: 8px;
				padding: 8px;
			}
			.product-card-body { min-width: 0; }
			.product-card-name {
				font-weight: 700;
				font-size: 1.05rem;
				margin-bottom: 0.35rem;
			}
			.product-card-notes {
				color: var(--muted);
				font-size: 0.9rem;
				margin: 0 0 0.75rem;
			}
			.product-card-cta {
				display: inline-block;
				background: var(--fg);
				color: var(--bg);
				text-decoration: none;
				font-weight: 600;
				font-size: 0.85rem;
				padding: 0.55rem 1rem;
				border-radius: 6px;
			}
			.product-card-cta:hover { opacity: 0.85; }
			@media (max-width: 480px) {
				.product-card { flex-direction: column; align-items: center; text-align: center; }
			}
		</style>
	</body>
</html>
