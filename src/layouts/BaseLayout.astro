---
import siteConfig from '../../site.config.json' with { type: 'json' };
import { getOrderedCategories } from '../lib/categories';
import { categorySlug } from '../lib/category-slug';

interface Props {
	title: string;
	description: string;
}

const { title, description } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const siteName = siteConfig.siteName;
const [siteNameFirstWord, ...siteNameRest] = siteName.split(' ');
const siteNameSecondLine = siteNameRest.join(' ');
const categories = await getOrderedCategories();
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<link rel="canonical" href={canonicalURL} />
		<title>{title} | {siteName}</title>
		<meta name="description" content={description} />

		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />

		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />

		<link rel="sitemap" href="/sitemap-index.xml" />
		<link
			rel="alternate"
			type="application/rss+xml"
			title={siteName}
			href={new URL('rss.xml', Astro.site)}
		/>
	</head>
	<body>
		<header class="site-header">
			<a class="brand" href="/">
				<img class="brand-mark" src="/dog-mark.svg" alt="" width="1080" height="1080" />
				<span class="brand-text">
					<span class="brand-line1">{siteNameFirstWord}</span>
					<span class="brand-line2">{siteNameSecondLine}</span>
				</span>
			</a>
			<nav class="site-nav">
				<a href="/">Home</a>
				<a href="/about">About</a>
				<a href="/search">Search</a>
				<div id="header-search" class="header-search"></div>
			</nav>
			<button id="menu-toggle" class="menu-toggle" aria-label="Open menu" aria-expanded="false">
				<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
			</button>
		</header>

		<div id="menu-overlay" class="menu-overlay"></div>
		<aside id="menu-drawer" class="menu-drawer" aria-hidden="true">
			<div class="menu-drawer-header">
				<span class="menu-drawer-title">Menu</span>
				<button id="menu-close" class="menu-close" aria-label="Close menu">&times;</button>
			</div>
			<a href="/">Home</a>
			<a href="/about">About</a>
			<a href="/search">Search</a>
			<div class="menu-drawer-label">Categories</div>
			{categories.map((category) => (
				<a href={`/category/${categorySlug(category)}/`}>{category}</a>
			))}
		</aside>

		<main>
			<slot />
		</main>

		<footer class="site-footer">
			<nav>
				<a href="/about">About</a>
				<a href="/contact">Contact</a>
				<a href="/privacy-policy">Privacy Policy</a>
				<a href="/affiliate-disclosure">Affiliate Disclosure</a>
			</nav>
			<p>&copy; {new Date().getFullYear()} {siteName}. As an Amazon Associate we earn from qualifying purchases.</p>
		</footer>

		<script is:inline>
			window.addEventListener('DOMContentLoaded', () => {
				const toggle = document.getElementById('menu-toggle');
				const close = document.getElementById('menu-close');
				const drawer = document.getElementById('menu-drawer');
				const overlay = document.getElementById('menu-overlay');
				const setOpen = (open) => {
					drawer.classList.toggle('open', open);
					overlay.classList.toggle('open', open);
					drawer.setAttribute('aria-hidden', String(!open));
					toggle.setAttribute('aria-expanded', String(open));
				};
				toggle?.addEventListener('click', () => setOpen(true));
				close?.addEventListener('click', () => setOpen(false));
				overlay?.addEventListener('click', () => setOpen(false));
			});
		</script>

		<link href="/pagefind/pagefind-ui.css" rel="stylesheet" />
		<script is:inline src="/pagefind/pagefind-ui.js"></script>
		<script is:inline>
			window.addEventListener('DOMContentLoaded', () => {
				if (typeof PagefindUI === 'function') {
					new PagefindUI({
						element: '#header-search',
						showSubResults: true,
						showEmptyFilters: false,
					});
				}
			});
		</script>

		<style is:global>
			:root {
				color-scheme: light dark;
				--fg: #1a1a1a;
				--bg: #ffffff;
				--muted: #666666;
				--accent: #b5651d;
				--border: #e5e5e5;
			}
			@media (prefers-color-scheme: dark) {
				:root {
					--fg: #eaeaea;
					--bg: #14141a;
					--muted: #a0a0a8;
					--border: #2a2a32;
				}
			}
			* { box-sizing: border-box; }
			body {
				margin: 0;
				font-family: system-ui, -apple-system, 'Segoe UI', sans-serif;
				color: var(--fg);
				background: var(--bg);
				line-height: 1.6;
			}
			main {
				max-width: 760px;
				margin: 0 auto;
				padding: 1.5rem 1.25rem 3rem;
			}
			.site-header, .site-footer {
				max-width: 1180px;
				margin: 0 auto;
				padding: 1.25rem;
				display: flex;
				justify-content: space-between;
				align-items: center;
				flex-wrap: wrap;
				gap: 0.75rem;
			}
			.site-footer {
				flex-direction: column;
				align-items: flex-start;
				border-top: 1px solid var(--border);
				color: var(--muted);
				font-size: 0.85rem;
			}
			.brand {
				display: flex;
				align-items: center;
				gap: 0.65rem;
				text-decoration: none;
				color: var(--fg);
			}
			.brand-mark { width: auto; height: 3.6rem; flex-shrink: 0; }
			.brand-text {
				display: flex;
				flex-direction: column;
				font-family: Georgia, 'Times New Roman', serif;
				font-weight: 700;
				line-height: 1.05;
			}
			.brand-line1 { font-size: 1.9rem; letter-spacing: 0.5px; }
			.brand-line2 { font-size: 1.5rem; letter-spacing: 0.5px; }
			nav { display: flex; align-items: center; }
			nav a { color: var(--muted); text-decoration: none; margin-right: 1rem; }
			nav a:hover { color: var(--accent); }

			.menu-toggle {
				display: flex;
				align-items: center;
				justify-content: center;
				background: none;
				border: none;
				color: var(--fg);
				cursor: pointer;
				padding: 0.4rem;
			}

			.menu-overlay {
				position: fixed;
				inset: 0;
				background: rgba(0, 0, 0, 0.5);
				opacity: 0;
				pointer-events: none;
				transition: opacity 0.2s;
				z-index: 90;
			}
			.menu-overlay.open { opacity: 1; pointer-events: auto; }

			.menu-drawer {
				position: fixed;
				top: 0;
				left: 0;
				bottom: 0;
				width: 280px;
				max-width: 80vw;
				background: var(--bg);
				border-right: 1px solid var(--border);
				transform: translateX(-100%);
				transition: transform 0.2s;
				z-index: 91;
				display: flex;
				flex-direction: column;
				padding: 1rem 0;
				overflow-y: auto;
			}
			.menu-drawer.open { transform: translateX(0); }
			.menu-drawer-header {
				display: flex;
				align-items: center;
				justify-content: space-between;
				padding: 0 1.25rem 1rem;
				border-bottom: 1px solid var(--border);
				margin-bottom: 0.5rem;
			}
			.menu-drawer-title { font-weight: 700; font-size: 1.1rem; }
			.menu-close {
				background: none;
				border: none;
				font-size: 1.5rem;
				line-height: 1;
				color: var(--muted);
				cursor: pointer;
				padding: 0.25rem;
			}
			.menu-drawer a {
				display: block;
				padding: 0.65rem 1.25rem;
				color: var(--fg);
				text-decoration: none;
				margin-right: 0;
			}
			.menu-drawer a:hover { background: color-mix(in srgb, var(--accent) 8%, transparent); }
			.menu-drawer-label {
				padding: 1rem 1.25rem 0.35rem;
				font-size: 0.75rem;
				text-transform: uppercase;
				letter-spacing: 0.5px;
				color: var(--muted);
				border-top: 1px solid var(--border);
				margin-top: 0.5rem;
			}

			@media (max-width: 640px) {
				.site-nav a { display: none; }
				.site-nav .header-search { margin-left: auto; }
			}

			/* Compact inline Pagefind box in the nav — fixed-width input, with
			   the results dropdown positioned absolutely so it overlays the
			   page instead of pushing the header taller. */
			.header-search { position: relative; width: 160px; }
			.header-search .pagefind-ui__form { margin: 0; }
			.header-search .pagefind-ui__search-input {
				width: 100%;
				padding: 0.3rem 0.5rem;
				font-size: 0.8rem;
				border: 1px solid var(--border);
				border-radius: 6px;
				background: var(--bg);
				color: var(--fg);
			}
			.header-search .pagefind-ui__search-clear { right: 0.4rem; }
			.header-search .pagefind-ui__drawer {
				position: absolute;
				top: calc(100% + 0.5rem);
				right: 0;
				width: 340px;
				max-width: calc(100vw - 2.5rem);
				max-height: 70vh;
				overflow-y: auto;
				background: var(--bg);
				border: 1px solid var(--border);
				border-radius: 10px;
				padding: 0.75rem;
				box-shadow: 0 8px 24px rgba(0, 0, 0, 0.15);
				z-index: 50;
			}
			.header-search .pagefind-ui__message { font-size: 0.85rem; }
			@media (max-width: 640px) {
				.header-search { width: 120px; }
			}
			img { max-width: 100%; }
			table { width: 100%; border-collapse: collapse; margin: 1.5rem 0; }
			th, td { border: 1px solid var(--border); padding: 0.5rem 0.75rem; text-align: left; }
			th { background: color-mix(in srgb, var(--accent) 12%, transparent); }

			/* "Pick card" — boxed product callout (image + name + blurb + CTA
			   button), one per product, inserted right after its "###
			   Product Name" heading (comparison articles) or right after the
			   paragraph that first mentions it (narrative-guide/qna).
			   Modeled on the review-roundup pattern (Wirecutter-style pick
			   boxes). */
			.product-card {
				display: flex;
				gap: 1.1rem;
				align-items: flex-start;
				border: 1px solid var(--border);
				border-radius: 10px;
				padding: 1rem;
				margin: 1rem 0 1.5rem;
				background: color-mix(in srgb, var(--accent) 4%, transparent);
			}
			.product-card img {
				width: 170px;
				height: 170px;
				object-fit: contain;
				flex-shrink: 0;
				background: #fff;
				border: 1px solid var(--border);
				border-radius: 8px;
				padding: 8px;
			}
			.product-card-body { min-width: 0; }
			.product-card-name {
				font-weight: 700;
				font-size: 1.05rem;
				margin-bottom: 0.35rem;
			}
			.product-card-notes {
				color: var(--muted);
				font-size: 0.9rem;
				margin: 0 0 0.75rem;
			}
			.product-card-cta {
				display: inline-block;
				background: var(--fg);
				color: var(--bg);
				text-decoration: none;
				font-weight: 600;
				font-size: 0.85rem;
				padding: 0.55rem 1rem;
				border-radius: 6px;
			}
			.product-card-cta:hover { opacity: 0.85; }
			@media (max-width: 480px) {
				.product-card { flex-direction: column; align-items: center; text-align: center; }
			}
		</style>
	</body>
</html>
