---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import siteConfig from '../../site.config.json' with { type: 'json' };
import { categorySlug } from '../lib/category-slug';
import { getOrderedCategories } from '../lib/categories';

const allPosts = await getCollection('posts', ({ data }) => !data.draft);
const posts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const categories = await getOrderedCategories();

const postsByCategory = categories.map((category) => ({
	category,
	posts: posts.filter((p) => p.data.category === category),
}));
---

<BaseLayout
	title="Home"
	description={`${siteConfig.siteName} — honest, practical buying guides for senior dog care.`}
>
	<h1>{siteConfig.siteName}</h1>
	<p>Practical, no-nonsense buying guides for senior dog care.</p>

	{posts.length === 0 && <p><em>No posts yet — the first batch is on its way.</em></p>}

	{postsByCategory.map(({ category, posts: categoryPosts }) => (
		<section class="category-section">
			<h2><a href={`/category/${categorySlug(category)}/`}>{category}</a></h2>
			<div class="post-grid">
				{categoryPosts.map((post) => (
					<a class="post-card" href={`/posts/${post.id}/`}>
						{post.data.heroImage && (
							<img src={post.data.heroImage} alt="" loading="lazy" />
						)}
						<div class="post-card-body">
							<h3>{post.data.title}</h3>
							<p>{post.data.description}</p>
						</div>
					</a>
				))}
			</div>
		</section>
	))}
</BaseLayout>

<style>
	.category-section { margin-top: 2.5rem; }
	.category-section h2 {
		font-size: 1.15rem;
		border-bottom: 1px solid var(--border);
		padding-bottom: 0.5rem;
	}
	.category-section h2 a {
		color: var(--fg);
		text-decoration: none;
	}
	.category-section h2 a:hover {
		color: var(--accent);
		text-decoration: underline;
	}
	/* Widen the page just for the homepage's card grid, so desktop can fit 5
	   columns; article pages keep the narrower 760px reading width. */
	:global(main) { max-width: 1180px; }

	.post-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
		gap: 1.25rem;
		margin-top: 1.25rem;
	}
	.post-card {
		display: flex;
		flex-direction: column;
		border: 1px solid var(--border);
		border-radius: 10px;
		overflow: hidden;
		text-decoration: none;
		color: var(--fg);
		transition: border-color 0.15s;
	}
	.post-card:hover { border-color: var(--accent); }
	.post-card img {
		width: 100%;
		aspect-ratio: 4 / 3;
		object-fit: cover;
		background: var(--border);
		border-bottom: 1px solid var(--border);
	}
	.post-card-body { padding: 0.9rem; }
	.post-card-body h3 { margin: 0 0 0.4rem; font-size: 1rem; line-height: 1.35; }
	.post-card-body p {
		margin: 0;
		font-size: 0.85rem;
		color: var(--muted);
		display: -webkit-box;
		-webkit-line-clamp: 3;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
</style>
